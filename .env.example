# Binance Exchange API
# Get these from https://www.binance.com/en/my/settings/api-management
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# Supabase (for storage and Phase 2 strategy editing)
# Get these from https://supabase.com/dashboard
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Telegram Bot (for notifications)
# Create a bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# AI Integration (optional)
# Get from Google AI Studio
GEMINI_API_KEY=your_gemini_api_key_here

# Authentication (for dashboard)
# Generate random strings for these
AUTH_SECRET=your_random_auth_secret_here
MAGIC_LINK_SECRET=your_random_magic_link_secret_here

# Node Environment
NODE_ENV=development